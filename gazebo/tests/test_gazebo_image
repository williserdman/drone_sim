#!/usr/bin/env bash
set -eo pipefail

python3 - <<'PYTHON'
from __future__ import annotations

import hashlib
import json
from pathlib import Path

gazebo_root = Path("/opt/drone_sim/gazebo")
manifest = json.loads(
    (gazebo_root / "provenance/ardupilot_gazebo-assets.json").read_text(
        encoding="utf-8"
    )
)
for item in manifest["files"]:
    imported = Path(item["imported_path"])
    path = gazebo_root / imported.relative_to("gazebo")
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != item["sha256"]:
        raise SystemExit(f"asset hash mismatch: {item['imported_path']}")
print(f"verified {len(manifest['files'])} provenance records")
PYTHON

while IFS='=' read -r package expected_version; do
    actual_version="$(dpkg-query -W -f='${Version}' "$package")"
    if [[ "$actual_version" != "$expected_version" ]]; then
        printf 'package mismatch: %s expected=%s actual=%s\n' \
            "$package" "$expected_version" "$actual_version" >&2
        exit 1
    fi
done < /etc/drone_sim/harmonic-packages.lock
printf 'verified %s locked apt packages\n' \
    "$(wc -l < /etc/drone_sim/harmonic-packages.lock)"

versions="$(gz sim --versions)"
printf '%s\n' "$versions"
grep --extended-regexp --quiet '^8[.]' <<<"$versions"
ros2 pkg prefix ros_gz_bridge
ros2 pkg prefix simulation_interfaces
python3 -c 'import drone_sim_gazebo.runtime.runtime_node; from simulation_interfaces.msg import FrameMetadata, GroundTruth, RunState'
test -x /opt/drone_sim/venv/bin/drone-sim-gazebo-runtime
test -s /etc/drone_sim/gazebo-bridge.yaml
python3 -m pytest -q /opt/drone_sim/source/tests/test_adapter_node.py

# Phase 3 must not contain an ArduPilotPlugin shared library.
plugin_path="$(
    find /lib /opt /usr -type f -iname '*ardupilot*plugin*.so*' -print -quit \
        2>/dev/null
)"
if [[ -n "$plugin_path" ]]; then
    printf 'forbidden ArduPilot plugin library: %s\n' "$plugin_path" >&2
    exit 1
fi
printf 'verified no ArduPilot plugin library\n'
