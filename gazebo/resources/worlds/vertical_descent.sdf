<?xml version="1.0"?>
<sdf version="1.9">
  <world name="vertical_descent">
    <gravity>0 0 -9.8</gravity>
    <physics name="vertical_descent_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0.1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <model name="ground_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
        <sensor name="iris_ground_contact" type="contact">
          <always_on>true</always_on><update_rate>20</update_rate>
          <contact><collision>ground_collision</collision></contact>
        </sensor>
      </link>
    </model>

    <model name="landing_marker">
      <pose>0 0 0.002 0 0 0</pose><static>true</static>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><cylinder><radius>0.5</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.05 1</ambient><diffuse>0.9 0.75 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://iris_flight</uri>
      <name>iris</name>
      <pose>0 0 0.195 0 0 0</pose>
      <static>false</static>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose><publish_link_pose>true</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose><publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>20</update_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions><odom_publish_frequency>20</odom_publish_frequency>
        <odom_topic>/gazebo/private/iris/odometry</odom_topic>
        <odom_frame>vertical_descent</odom_frame><robot_base_frame>iris</robot_base_frame>
      </plugin>
    </include>

    <model name="observer_station">
      <pose>3 -3 2.5 0 0.45 2.356194490192345</pose><static>true</static>
      <link name="observer_link">
        <sensor name="observer_camera" type="camera">
          <pose>0 0 0 0 0 0</pose><always_on>true</always_on><update_rate>20</update_rate>
          <topic>/gazebo/private/camera/observer/image</topic>
          <camera>
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
