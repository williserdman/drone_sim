<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="payload_2">
    <link name="body">
      <inertial>
        <mass>1.133981</mass>
        <inertia>
          <ixx>0.002439</ixx>
          <iyy>0.002439</iyy>
          <izz>0.00439</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.1524 0.1524 0.0508</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.1524 0.1524 0.0508</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="marker">
        <pose>0 0 0.0264 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.1 0.1</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/marker_2.png</albedo_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <sensor name="ground_contact" type="contact">
        <topic>/gazebo/private/payload/2/contacts</topic>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <contact>
          <collision>body_collision</collision>
        </contact>
      </sensor>
    </link>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
  </model>
</sdf>