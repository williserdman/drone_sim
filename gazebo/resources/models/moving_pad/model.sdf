<?xml version="1.0"?>
<sdf version="1.9">
  <model name="moving_pad">
    <static>false</static>
    <link name="deck">
      <inertial>
        <pose>0 0 0.1 0 0 0</pose>
        <mass>50</mass>
        <inertia>
          <ixx>37.5</ixx>
          <iyy>37.5</iyy>
          <izz>75</izz>
        </inertia>
      </inertial>
      <collision name="deck_collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>3 3 0.2</size></box></geometry>
        <surface>
          <friction><ode><mu>2</mu><mu2>2</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="deck_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>3 3 0.2</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="marker_7">
        <pose>0 0 0.2005 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.1 0.1</size></plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/marker_7.png</albedo_map>
            <roughness>1</roughness>
            <metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <sensor name="pad_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <contact>
          <collision>deck_collision</collision>
          <topic>/gazebo/private/moving_pad/contact</topic>
        </contact>
      </sensor>
    </link>
    <joint name="rail_joint" type="prismatic">
      <parent>world</parent>
      <child>deck</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1000</lower><upper>1000</upper><effort>1000000</effort></limit>
      </axis>
    </joint>
  </model>
</sdf>
