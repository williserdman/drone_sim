    </plugin>
    <link name="competition_sensor_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="downward_camera" type="camera">
        <pose>0 0 -0.1 0 1.570796327 0</pose>
        <topic>/gazebo/private/camera/onboard/image</topic>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>0.6</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>200</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="downward_range" type="gpu_lidar">
        <pose>0.3 0 -0.1 0 1.570796327 0</pose>
        <topic>/gazebo/private/range/downward</topic>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>40</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
    <joint name="competition_sensor_joint" type="fixed">
      <parent>airframe::base_link</parent>
      <child>competition_sensor_link</child>
    </joint>
    <link name="payload_hardpoint">
      <pose>0 0 -0.13 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="payload_hardpoint_joint" type="fixed">
      <parent>airframe::base_link</parent>
      <child>payload_hardpoint</child>
    </joint>
    <plugin filename="libcwru_payload_command_coordinator.so" name="drone_sim::gazebo::PayloadCommandCoordinator">
      <command_topic>/gazebo/private/payload/2/command</command_topic>
      <physical_state_topic>/gazebo/private/payload/2/joint_state</physical_state_topic>
      <result_topic>/gazebo/private/payload/2/result</result_topic>
      <stock_attach_topic>/gazebo/private/payload/2/physical/attach</stock_attach_topic>
      <stock_detach_topic>/gazebo/private/payload/2/physical/detach</stock_detach_topic>
    </plugin>
    <plugin filename="libdrone_sim_detachable_joint_system.so" name="drone_sim::gazebo::DetachableJoint">
      <parent_link>payload_hardpoint</parent_link>
      <child_model>payload_2</child_model>
      <child_link>body</child_link>
      <attach_topic>/gazebo/private/payload/2/physical/attach</attach_topic>
      <detach_topic>/gazebo/private/payload/2/physical/detach</detach_topic>
      <output_topic>/gazebo/private/payload/2/joint_state</output_topic>
      <initially_attached>true</initially_attached>
    </plugin>
    <plugin filename="libcwru_payload_command_coordinator.so" name="drone_sim::gazebo::PayloadCommandCoordinator">
      <command_topic>/gazebo/private/payload/3/command</command_topic>
      <physical_state_topic>/gazebo/private/payload/3/joint_state</physical_state_topic>
      <result_topic>/gazebo/private/payload/3/result</result_topic>
      <stock_attach_topic>/gazebo/private/payload/3/physical/attach</stock_attach_topic>
      <stock_detach_topic>/gazebo/private/payload/3/physical/detach</stock_detach_topic>
    </plugin>
    <plugin filename="libdrone_sim_detachable_joint_system.so" name="drone_sim::gazebo::DetachableJoint">
      <parent_link>payload_hardpoint</parent_link>
      <child_model>payload_3</child_model>
      <child_link>body</child_link>
      <attach_topic>/gazebo/private/payload/3/physical/attach</attach_topic>
      <detach_topic>/gazebo/private/payload/3/physical/detach</detach_topic>
      <output_topic>/gazebo/private/payload/3/joint_state</output_topic>
      <initially_attached>false</initially_attached>
    </plugin>
    <plugin filename="libcwru_payload_command_coordinator.so" name="drone_sim::gazebo::PayloadCommandCoordinator">
      <command_topic>/gazebo/private/payload/4/command</command_topic>
      <physical_state_topic>/gazebo/private/payload/4/joint_state</physical_state_topic>
      <result_topic>/gazebo/private/payload/4/result</result_topic>
      <stock_attach_topic>/gazebo/private/payload/4/physical/attach</stock_attach_topic>
      <stock_detach_topic>/gazebo/private/payload/4/physical/detach</stock_detach_topic>
    </plugin>
    <plugin filename="libdrone_sim_detachable_joint_system.so" name="drone_sim::gazebo::DetachableJoint">
      <parent_link>payload_hardpoint</parent_link>
      <child_model>payload_4</child_model>
      <child_link>body</child_link>
      <attach_topic>/gazebo/private/payload/4/physical/attach</attach_topic>
      <detach_topic>/gazebo/private/payload/4/physical/detach</detach_topic>
      <output_topic>/gazebo/private/payload/4/joint_state</output_topic>
      <initially_attached>false</initially_attached>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
