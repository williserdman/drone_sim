 #include "gz/rendering/base/SceneExt.hh"
 #include "gz/rendering/GraphicsAPI.hh"
@@ -1420,9 +1423,20 @@ void Ogre2Scene::CreateContext()
 {
   Ogre::Root *root = Ogre2RenderEngine::Instance()->OgreRoot();
 
-  // getNumLogicalCores() may return 0 if couldn't detect
-  const size_t numThreads = std::max<size_t>(
-      1, Ogre::PlatformInformation::getNumLogicalCores());
+  // Avoid per-frame worker barriers for ordinary Gazebo scenes. This is a
+  // narrow backport of https://github.com/gazebosim/gz-rendering/pull/1302.
+  // Zero runs the passes inline; large scenes can opt back into workers.
+  size_t numThreads = 0u;
+  std::string configuredThreads;
+  if (gz::common::env(
+      "GZ_RENDERING_OGRE2_WORKER_THREADS", configuredThreads))
+  {
+    const int requestedThreads = std::atoi(configuredThreads.c_str());
+    if (requestedThreads > 0)
+    {
+      numThreads = static_cast<size_t>(requestedThreads);
+    }
+  }
 
