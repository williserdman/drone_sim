{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world",
    "vehicle",
    "mission",
    "scenario",
    "output_root",
    "max_wall_seconds",
    "startup_wall_seconds",
    "finalization_wall_seconds",
    "recording"
  ],
  "properties": {
    "world": {"type": "string", "minLength": 1},
    "vehicle": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "max_wall_seconds": {"type": "integer", "minimum": 1},
    "startup_wall_seconds": {"type": "integer", "minimum": 1},
    "finalization_wall_seconds": {"type": "integer", "minimum": 1},
    "recording": {"$ref": "#/$defs/recording"},
    "runtime_profile": {"enum": ["phase2", "phase3"]},
    "simulation": {"$ref": "#/$defs/simulation"}
  },
  "allOf": [
    {
      "if": {
        "required": ["runtime_profile"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "then": {"required": ["simulation"]},
      "else": {"not": {"required": ["simulation"]}}
    }
  ],
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps", "encoding"],
      "properties": {
        "width_px": {"const": 320},
        "height_px": {"const": 240},
        "fps": {"const": 20},
        "encoding": {"const": "rgb8"}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "duration_sim_seconds", "target_real_time_factor"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "duration_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_real_time_factor": {"const": 0.1}
      }
    }
  }
}
