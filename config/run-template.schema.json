{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world",
    "vehicle",
    "mission",
    "scenario",
    "output_root",
    "max_wall_seconds",
    "startup_wall_seconds",
    "finalization_wall_seconds",
    "recording"
  ],
  "properties": {
    "world": {"type": "string", "minLength": 1},
    "vehicle": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "max_wall_seconds": {"type": "integer", "minimum": 1},
    "startup_wall_seconds": {"type": "integer", "minimum": 1},
    "finalization_wall_seconds": {"type": "integer", "minimum": 1},
    "recording": {"$ref": "#/$defs/recording"},
    "runtime_profile": {"enum": ["phase2", "phase3"]},
    "simulation": {"$ref": "#/$defs/simulation"},
    "competition": {"$ref": "#/$defs/competition"},
    "qgc": {"$ref": "#/$defs/qgc"},
    "mission_plan": {"$ref": "#/$defs/mission_plan"}
  },
  "allOf": [
    {
      "if": {
        "required": ["runtime_profile"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "then": {"required": ["simulation"]},
      "else": {"not": {"required": ["simulation"]}}
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "not": {"enum": ["competition_v1", "search_delivery_v1"]}
          }
        }
      },
      "then": {"properties": {"recording": {"$ref": "#/$defs/baseline_recording"}}}
    },
    {
      "if": {"properties": {"mission": {"const": "comp2026_auto"}}},
      "then": {
        "required": ["competition", "qgc"],
        "properties": {"scenario": {"const": "competition_v1"}}
      }
    },
    {
      "if": {"required": ["qgc"]},
      "then": {
        "required": ["runtime_profile"],
        "properties": {
          "runtime_profile": {"const": "phase3"},
          "mission": {"const": "comp2026_auto"}
        }
      }
    },
    {
      "if": {"properties": {"mission": {"const": "configured"}}},
      "then": {
        "required": ["runtime_profile", "mission_plan"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "else": {"not": {"required": ["mission_plan"]}}
    },
    {
      "if": {"properties": {"scenario": {"const": "competition_v1"}}},
      "then": {
        "required": ["runtime_profile", "competition"],
        "properties": {
          "runtime_profile": {"const": "phase3"},
          "world": {"const": "competition_mission"},
          "vehicle": {"const": "iris_competition"},
          "mission": {"enum": ["configured", "comp2026_auto"]},
          "recording": {"$ref": "#/$defs/competition_recording"}
        }
      }
    },
    {
      "if": {"properties": {"scenario": {"const": "search_delivery_v1"}}},
      "then": {
        "required": ["runtime_profile", "competition", "mission_plan"],
        "properties": {
          "runtime_profile": {"const": "phase3"},
          "world": {"const": "search_delivery"},
          "vehicle": {"const": "iris_search_delivery"},
          "mission": {"const": "configured"},
          "recording": {"$ref": "#/$defs/search_delivery_recording"},
          "simulation": {"$ref": "#/$defs/search_delivery_simulation"}
        }
      }
    }
  ],
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps", "encoding"],
      "properties": {
        "width_px": {"enum": [320, 640]},
        "height_px": {"enum": [240, 480]},
        "observer_width_px": {"enum": [320, 640, 1280]},
        "observer_height_px": {"enum": [240, 480, 960]},
        "fps": {"const": 20},
        "encoding": {"const": "rgb8"}
      },
      "dependentRequired": {
        "observer_width_px": ["observer_height_px"],
        "observer_height_px": ["observer_width_px"]
      },
      "oneOf": [
        {"properties": {"width_px": {"const": 320}, "height_px": {"const": 240}}},
        {"properties": {"width_px": {"const": 640}, "height_px": {"const": 480}}}
      ]
    },
    "competition_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 640},
        "height_px": {"const": 480},
        "observer_width_px": {"const": 640},
        "observer_height_px": {"const": 480}
      }
    },
    "baseline_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 320},
        "height_px": {"const": 240},
        "observer_width_px": {"const": 320},
        "observer_height_px": {"const": 240}
      }
    },
    "search_delivery_recording": {
      "type": "object",
      "required": ["observer_width_px", "observer_height_px"],
      "properties": {
        "width_px": {"const": 640},
        "height_px": {"const": 480},
        "observer_width_px": {"const": 1280},
        "observer_height_px": {"const": 960}
      }
    },
    "search_delivery_simulation": {
      "type": "object",
      "properties": {
        "duration_sim_seconds": {"const": 240.0},
        "public_epoch_native_sim_seconds": {"const": 90.0},
        "target_real_time_factor": {"const": 1.0}
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course", "scenario"],
      "properties": {
        "course": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "scenario": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      }
    },
    "qgc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_profile", "listener_session", "qgc_actions", "runtime_policy"],
      "properties": {
        "deployment_profile": {"$ref": "#/$defs/qgc_source_path"},
        "listener_session": {"$ref": "#/$defs/qgc_source_path"},
        "qgc_actions": {"$ref": "#/$defs/qgc_source_path"},
        "runtime_policy": {"$ref": "#/$defs/qgc_source_path"}
      }
    },
    "qgc_source_path": {
      "type": "string",
      "pattern": "^(?!/)(?!\\./)(?!\\.?\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000\\r\\n]).+$"
    },
    "mission_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "steps"],
      "properties": {
        "schema_version": {"const": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mission_step"}
        }
      }
    },
    "mission_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "args": {"type": "object"},
        "timeout_sim_s": {"type": "number", "exclusiveMinimum": 0, "default": 60}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "duration_sim_seconds", "public_epoch_native_sim_seconds", "target_real_time_factor"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "duration_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "public_epoch_native_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.05
        },
        "target_real_time_factor": {"enum": [0.1, 0.25, 1.0]}
      }
    }
  }
}
