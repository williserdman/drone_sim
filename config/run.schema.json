{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "world",
    "vehicle",
    "mission",
    "scenario",
    "output_root",
    "max_wall_seconds",
    "startup_wall_seconds",
    "finalization_wall_seconds",
    "recording",
    "config_sha256"
  ],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "world": {"type": "string", "minLength": 1},
    "vehicle": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "max_wall_seconds": {"type": "integer", "minimum": 1},
    "startup_wall_seconds": {"type": "integer", "minimum": 1},
    "finalization_wall_seconds": {"type": "integer", "minimum": 1},
    "recording": {"$ref": "#/$defs/recording"},
    "runtime_profile": {"enum": ["phase2", "phase3"]},
    "simulation": {"$ref": "#/$defs/simulation"},
    "competition": {"$ref": "#/$defs/competition"},
    "mission_plan": {"$ref": "#/$defs/mission_plan"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "required": ["runtime_profile"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "then": {"required": ["simulation"]},
      "else": {"not": {"required": ["simulation"]}}
    },
    {
      "if": {"anyOf": [
        {"properties": {"mission": {"const": "comp2026_auto"}}, "required": ["mission"]},
        {"properties": {"scenario": {"const": "competition_2027_v1"}}, "required": ["scenario"]}
      ]},
      "then": {"properties": {"recording": {"$ref": "#/$defs/competition_recording"}}},
      "else": {"properties": {"recording": {"$ref": "#/$defs/baseline_recording"}}}
    },
    {
      "if": {"anyOf": [
        {"properties": {"mission": {"const": "comp2026_auto"}}, "required": ["mission"]},
        {"properties": {"scenario": {"const": "competition_2027_v1"}}, "required": ["scenario"]}
      ]},
      "then": {"required": ["competition"]}
    },
    {
      "if": {"properties": {"mission": {"const": "configured"}}},
      "then": {
        "required": ["runtime_profile", "mission_plan"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "else": {"not": {"required": ["mission_plan"]}}
    },
    {
      "if": {
        "properties": {"scenario": {"const": "competition_2027_v1"}},
        "required": ["scenario"]
      },
      "then": {
        "required": ["runtime_profile", "simulation", "competition", "mission_plan"],
        "properties": {
          "world": {"const": "competition_2027"},
          "vehicle": {"const": "iris_competition_2027"},
          "mission": {"const": "configured"},
          "runtime_profile": {"const": "phase3"},
          "mission_plan": {
            "properties": {"schema_version": {"const": 2}}
          },
          "simulation": {
            "properties": {"duration_sim_seconds": {"minimum": 780}}
          }
        }
      }
    }
  ],
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps", "encoding"],
      "properties": {
        "width_px": {"enum": [320, 640]},
        "height_px": {"enum": [240, 480]},
        "fps": {"const": 20},
        "encoding": {"const": "rgb8"}
      },
      "oneOf": [
        {"properties": {"width_px": {"const": 320}, "height_px": {"const": 240}}},
        {"properties": {"width_px": {"const": 640}, "height_px": {"const": 480}}}
      ]
    },
    "competition_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 640},
        "height_px": {"const": 480}
      }
    },
    "baseline_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 320},
        "height_px": {"const": 240}
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course", "scenario", "course_sha256", "scenario_sha256"],
      "properties": {
        "course": {"const": "course.yaml"},
        "scenario": {"const": "scenario.yaml"},
        "course_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "mission_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "steps"],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "steps": {
          "type": "array",
          "minItems": 1
        }
      },
      "allOf": [{
        "if": {"properties": {"schema_version": {"const": 1}}},
        "then": {"properties": {"steps": {"items": {"$ref": "#/$defs/mission_step"}}}},
        "else": {"properties": {"steps": {"items": {"oneOf": [
          {"$ref": "#/$defs/mission_step"},
          {"$ref": "#/$defs/outer_conditional_group"}
        ]}}}}
      }]
    },
    "mission_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args", "timeout_sim_s"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "args": {"type": "object"},
        "timeout_sim_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "outer_conditional_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "steps"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_payload_eligible"],
          "properties": {"any_payload_eligible": {"const": true}}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"oneOf": [
            {"$ref": "#/$defs/mission_step"},
            {"$ref": "#/$defs/payload_conditional_group"}
          ]}
        }
      }
    },
    "payload_conditional_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "steps"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload_eligible"],
          "properties": {"payload_eligible": {"enum": [2, 3, 4]}}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mission_step"}
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "duration_sim_seconds", "public_epoch_native_sim_seconds", "target_real_time_factor"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "duration_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "public_epoch_native_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.05
        },
        "target_real_time_factor": {"enum": [0.1, 0.25, 1.0]}
      }
    }
  }
}
