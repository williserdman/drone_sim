{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "world",
    "vehicle",
    "mission",
    "scenario",
    "output_root",
    "max_wall_seconds",
    "startup_wall_seconds",
    "finalization_wall_seconds",
    "recording",
    "config_sha256"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "world": {"type": "string", "minLength": 1},
    "vehicle": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "max_wall_seconds": {"type": "integer", "minimum": 1},
    "startup_wall_seconds": {"type": "integer", "minimum": 1},
    "finalization_wall_seconds": {"type": "integer", "minimum": 1},
    "recording": {"$ref": "#/$defs/recording"},
    "runtime_profile": {"enum": ["phase2", "phase3"]},
    "simulation": {"$ref": "#/$defs/simulation"},
    "competition": {"$ref": "#/$defs/competition"},
    "qgc": {"$ref": "#/$defs/qgc"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "required": ["runtime_profile"],
        "properties": {"runtime_profile": {"const": "phase3"}}
      },
      "then": {"required": ["simulation"]},
      "else": {"not": {"required": ["simulation"]}}
    },
    {
      "if": {
        "properties": {
          "mission": {"const": "comp2026_auto"}
        }
      },
      "then": {"properties": {"recording": {"$ref": "#/$defs/competition_recording"}}},
      "else": {"properties": {"recording": {"$ref": "#/$defs/baseline_recording"}}}
    },
    {
      "if": {"properties": {"mission": {"const": "comp2026_auto"}}},
      "then": {"required": ["competition"]}
    },
    {
      "if": {"required": ["qgc"]},
      "then": {
        "required": ["runtime_profile"],
        "properties": {
          "runtime_profile": {"const": "phase3"},
          "mission": {"const": "comp2026_auto"}
        }
      }
    }
  ],
  "$defs": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps", "encoding"],
      "properties": {
        "width_px": {"enum": [320, 640]},
        "height_px": {"enum": [240, 480]},
        "fps": {"const": 20},
        "encoding": {"const": "rgb8"}
      },
      "oneOf": [
        {"properties": {"width_px": {"const": 320}, "height_px": {"const": 240}}},
        {"properties": {"width_px": {"const": 640}, "height_px": {"const": 480}}}
      ]
    },
    "competition_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 640},
        "height_px": {"const": 480}
      }
    },
    "baseline_recording": {
      "type": "object",
      "properties": {
        "width_px": {"const": 320},
        "height_px": {"const": 240}
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course", "scenario", "course_sha256", "scenario_sha256"],
      "properties": {
        "course": {"const": "course.yaml"},
        "scenario": {"const": "scenario.yaml"},
        "course_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "qgc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_profile",
        "deployment_profile_sha256",
        "listener_session",
        "listener_session_sha256",
        "qgc_actions",
        "qgc_actions_sha256",
        "runtime_policy",
        "runtime_policy_sha256",
        "attempt_state_id",
        "attempt_state_root"
      ],
      "properties": {
        "deployment_profile": {"const": "deployment-profile.json"},
        "deployment_profile_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "listener_session": {"const": "listener-session.json"},
        "listener_session_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "qgc_actions": {"const": "qgc-actions.json"},
        "qgc_actions_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "runtime_policy": {"const": "qgc-runtime.json"},
        "runtime_policy_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "attempt_state_id": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256-[0-9a-f]{64}$"},
        "attempt_state_root": {"$ref": "#/$defs/absolute_canonical_path"}
      }
    },
    "absolute_canonical_path": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*(?:/\\.\\.?)(?:/|$))(?!.*[\\u0000\\r\\n]).+$"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "duration_sim_seconds", "public_epoch_native_sim_seconds", "target_real_time_factor"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "duration_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "public_epoch_native_sim_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.05
        },
        "target_real_time_factor": {"enum": [0.1, 0.25, 1.0]}
      }
    }
  }
}
