# Minimal Iris JSON-SITL parameters for the descent_v1 vertical slice.
FRAME_CLASS 1
FRAME_TYPE 1
AHRS_EKF_TYPE 10
# Verified competition roll-rate gains retain stable physical takeoff response.
ATC_RAT_RLL_P 0.0675
ATC_RAT_RLL_I 0.0675
ATC_RAT_RLL_D 0.0018
ATC_RAT_PIT_P 0.0675
ATC_RAT_PIT_I 0.0675
ATC_RAT_PIT_D 0.0018
# Match ArduPilot's pinned Copter SITL defaults: non-zero offsets identify the
# two simulated accelerometers as calibrated without bypassing pre-arm checks.
INS_ACCOFFS_X 0.001
INS_ACCOFFS_Y 0.001
INS_ACCOFFS_Z 0.001
INS_ACCSCAL_X 1.001
INS_ACCSCAL_Y 1.001
INS_ACCSCAL_Z 1.001
INS_ACC2OFFS_X 0.001
INS_ACC2OFFS_Y 0.001
INS_ACC2OFFS_Z 0.001
INS_ACC2SCAL_X 1.001
INS_ACC2SCAL_Y 1.001
INS_ACC2SCAL_Z 1.001
FS_THR_ENABLE 0
FLTMODE_CH 0
# Copter 4.7's final LAND-stage descent target. Keep touchdown deliberately
# slow while remaining well below the competition's vertical-speed limit.
LAND_SPD_MS 0.10
PLND_ENABLED 1
PLND_TYPE 1
# Compensate the measured onboard-frame to MAVLink receipt latency.
PLND_LAG 0.08
# The simulator target is stationary and camera measurements are physically accurate;
# consume each measurement directly instead of the oscillatory Kalman estimate.
PLND_EST_TYPE 0
LOG_BACKEND_TYPE 1
LOG_DISARMED 1
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 115
# Passive pre-RUNNING SYS_STATUS keeps pre-arm readiness observable.
MAV1_EXT_STAT 1
