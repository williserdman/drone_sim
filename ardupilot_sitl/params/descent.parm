# Minimal Iris JSON-SITL parameters for the descent_v1 vertical slice.
FRAME_CLASS 1
FRAME_TYPE 1
AHRS_EKF_TYPE 10
# Roll-only AutoTune gains promoted from run 881fe09d-08ef-4ca5-8304-fe79c5220e61.
ATC_RAT_RLL_P 0.0503722
ATC_RAT_RLL_I 0.0503722
ATC_RAT_RLL_D 0.000375
ATC_RAT_PIT_P 0.0675
ATC_RAT_PIT_I 0.0675
ATC_RAT_PIT_D 0.0018
# Match ArduPilot's pinned Copter SITL defaults: non-zero offsets identify the
# two simulated accelerometers as calibrated without bypassing pre-arm checks.
INS_ACCOFFS_X 0.001
INS_ACCOFFS_Y 0.001
INS_ACCOFFS_Z 0.001
INS_ACCSCAL_X 1.001
INS_ACCSCAL_Y 1.001
INS_ACCSCAL_Z 1.001
INS_ACC2OFFS_X 0.001
INS_ACC2OFFS_Y 0.001
INS_ACC2OFFS_Z 0.001
INS_ACC2SCAL_X 1.001
INS_ACC2SCAL_Y 1.001
INS_ACC2SCAL_Z 1.001
FS_THR_ENABLE 0
FLTMODE_CH 0
# Copter 4.5.7 expresses the final LAND-stage descent target in cm/s.
LAND_SPEED 50
PLND_ENABLED 1
PLND_TYPE 1
# Keep the requested descent speed during precision landing instead of allowing
# the precision-landing controller to reduce it near touchdown (bit 2).
PLND_OPTIONS 4
# Compensate the measured onboard-frame to MAVLink receipt latency.
PLND_LAG 0.08
# The simulator target is stationary and camera measurements are physically accurate;
# consume each measurement directly instead of the oscillatory Kalman estimate.
PLND_EST_TYPE 0
LOG_BACKEND_TYPE 1
LOG_DISARMED 1
SERIAL0_PROTOCOL 2
SERIAL0_BAUD 115
# Channel 0 passive pre-RUNNING SYS_STATUS keeps pre-arm readiness observable.
SR0_EXT_STAT 1
ATC_ANG_RLL_P 13.1974
# Copter 4.5.7 stores this physical 2547.76 deg/s/s limit in cdeg/s/s.
ATC_ACCEL_R_MAX 254776
